# Reference only: set these in your shell for local runs, or in Vercel > Settings > Environment Variables. Never commit real values.

# WordPress site root (no trailing slash). Default is the serverless WordPress on Vercel.
# WP_API_BASE=https://serverless-wordpress-ebon-kappa.vercel.app

# "rest_route" (default) works without pretty permalinks. Use "wp-json" if /wp-json/ returns JSON.
# WP_REST_STYLE=rest_route

# Test posts are shown locally and in Vercel Preview, always hidden in Production. Set this to hide them locally too.
# BLOG_HIDE_TEST=1

